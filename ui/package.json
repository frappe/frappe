{
  "name": "@framework/ui",
  "version": "0.0.0",
  "description": "Shared client components and utilities for Frappe apps",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
