{
	"name": "studio-ui",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "node scripts/unlink-frappe-ui.mjs && yarn install-framework-ui && vite",
		"dev:frappe-ui": "node scripts/link-frappe-ui.mjs && yarn install-framework-ui && vite",
		"build": "node scripts/unlink-frappe-ui.mjs && yarn install-framework-ui && vite build --base=/assets/studio/frontend/ && yarn copy-html-entry && yarn copy-studio-renderer",
		"build-studio-app": "node scripts/unlink-frappe-ui.mjs && yarn install-framework-ui && node src/scripts/build.js",
		"install-framework-ui": "[ ! -d ../../frappe/ui ] || [ -d ../../frappe/ui/node_modules/leaflet ] || yarn --cwd ../../frappe/ui install",
		"copy-html-entry": "cp ../studio/public/frontend/index.html ../studio/www/studio.html",
		"copy-studio-renderer": "cp ../studio/public/frontend/renderer.html ../studio/templates/generators/studio_renderer.html",
		"serve": "vite preview",
		"generate:css-metadata": "node ./scripts/generate-css-property-metadata.mjs",
		"extract-frappeui-types": "tsx src/scripts/tsToJSONGenerator.ts frappeui",
		"extract-frameworkui-types": "tsx src/scripts/tsToJSONGenerator.ts frameworkui",
		"extract-studio-types": "tsx src/scripts/tsToJSONGenerator.ts studio",
		"test:cypress": "cypress run --component",
		"test:cypress:open": "cypress open --component"
	},
	"dependencies": {
		"@codemirror/lang-css": "^6.3.1",
		"@codemirror/lang-html": "^6.4.9",
		"@codemirror/lang-javascript": "^6.2.4",
		"@codemirror/lang-json": "^6.0.1",
		"@codemirror/lang-vue": "^0.1.3",
		"@framework/ui": "link:../../frappe/ui",
		"@replit/codemirror-indentation-markers": "^6.5.3",
		"@vitejs/plugin-vue": "^6.0.0",
		"@vueuse/components": "^10.11.1",
		"@vueuse/core": "^10.11.1",
		"ace-builds": "^1.36.2",
		"autoprefixer": "^10.4.2",
		"codemirror": "^6.0.1",
		"dompurify": "^3.4.0",
		"frappe-ui": "1.0.0-beta.25",
		"json5": "^2.2.3",
		"marked": "^15.0.6",
		"pinia": "^2.2.1",
		"reka-ui": "^2.9.9",
		"thememirror": "^2.0.1",
		"typescript": "^5.8.3",
		"vite": "8.0.13",
		"vue": "^3.5.14",
		"vue-codemirror": "^6.1.1",
		"vue-router": "^4.2.2",
		"vuedraggable": "^4.1.0"
	},
	"devDependencies": {
		"cypress": "^15.8.2",
		"eslint": "^8.19.0",
		"eslint-plugin-vue": "^9.11.0",
		"mdn-data": "2.27.1",
		"postcss": "^8.4.5",
		"prettier": "3.3.3",
		"prettier-plugin-tailwindcss": "0.6.11",
		"tailwindcss": "^3.4.3",
		"ts-json-schema-generator": "2.3.0",
		"tsx": "^4.19.2",
		"web-features": "3.34.1"
	}
}
