{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "EmailComposerProps": {
      "type": "object",
      "properties": {
        "placeholder": {
          "type": "string"
        },
        "submitLabel": {
          "type": "string"
        },
        "uploadFunction": {
          "type": "object"
        },
        "extensions": {
          "type": "array",
          "items": {}
        },
        "maxAttachments": {
          "type": "number"
        },
        "submitting": {
          "type": "boolean"
        },
        "showTo": {
          "type": "boolean"
        },
        "showCc": {
          "type": "boolean"
        },
        "showBcc": {
          "type": "boolean"
        },
        "showFrom": {
          "type": "boolean"
        },
        "showSubject": {
          "type": "boolean"
        },
        "senders": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "email": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "image": {
                "type": "string"
              }
            },
            "required": [
              "email"
            ],
            "additionalProperties": false
          }
        },
        "searchRecipients": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "EmailComposerSlots": {
      "type": "object",
      "properties": {
        "header": {
          "type": "object"
        },
        "actions": {
          "type": "object"
        },
        "footer": {
          "type": "object"
        }
      },
      "additionalProperties": false
    }
  }
}