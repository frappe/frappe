{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "FileUploadDialogProps": {
      "type": "object",
      "properties": {
        "open": {
          "type": "boolean"
        },
        "multiple": {
          "type": "boolean"
        },
        "imageOnly": {
          "type": "boolean"
        },
        "crop": {
          "type": "boolean"
        },
        "restrictions": {
          "type": "object",
          "properties": {
            "max_file_size": {
              "type": [
                "number",
                "null"
              ]
            },
            "max_number_of_files": {
              "type": [
                "number",
                "null"
              ]
            },
            "allowed_file_types": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "crop_image_aspect_ratio": {
              "type": [
                "number",
                "null"
              ]
            }
          },
          "additionalProperties": false
        },
        "transport": {
          "type": "object"
        },
        "progressMode": {
          "type": "string",
          "enum": [
            "inline",
            "tray",
            "field",
            "toast"
          ]
        },
        "folder": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "trayLabel": {
          "type": "string"
        }
      },
      "required": [
        "open"
      ],
      "additionalProperties": false
    }
  }
}