                    "email": {
                      "type": "string"
                    },
                    "fullname": {
                      "type": "string"
                    },
                    "image": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                },
                "icon": {
                  "type": [
                    "string"
                  ]
                },
