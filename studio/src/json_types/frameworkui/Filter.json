{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "*": {
      "type": "object",
      "properties": {
        "fieldname": {
          "type": "string"
        },
        "operator": {
          "type": "string",
          "enum": [
            "equals",
            "not equals",
            "like",
            "not like",
            "in",
            "not in",
            "is",
            "is not",
            "<",
            ">",
            "<=",
            ">=",
            "between",
            "timespan"
          ]
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "boolean"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "field": {
          "type": "object",
          "properties": {
            "label": {
              "type": "string"
            },
            "value": {
              "type": "string"
            },
            "fieldname": {
              "type": "string"
            },
            "fieldtype": {
              "type": "string"
            },
            "options": {
              "type": "string"
            }
          },
          "required": [
            "label",
            "value",
            "fieldname",
            "fieldtype"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "fieldname",
        "operator",
        "value"
      ],
      "additionalProperties": false
    }
  }
}