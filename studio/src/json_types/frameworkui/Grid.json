{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "GridProps": {
      "type": "object",
      "properties": {
        "columns": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "fieldname": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "reqd": {
                "type": "boolean"
              },
              "align": {
                "type": "string",
                "enum": [
                  "left",
                  "right",
                  "center"
                ]
              },
              "width": {
                "type": "number"
              }
            },
            "required": [
              "fieldname"
            ],
            "additionalProperties": false
          }
        },
        "disabled": {
          "type": "boolean"
        },
        "label": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                },
                "stack": {
                  "type": "string"
                },
                "messages": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "additionalProperties": false,
              "required": [
                "message",
                "name"
              ]
            }
          ]
        },
        "required": {
          "type": "boolean"
        }
      },
      "required": [
        "columns"
      ],
      "additionalProperties": false
    }
  }
}