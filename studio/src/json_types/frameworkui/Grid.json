{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "*": {
      "type": "object",
      "properties": {
        "fieldname": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "reqd": {
          "type": "boolean"
        },
        "align": {
          "type": "string",
          "enum": [
            "left",
            "right",
            "center"
          ]
        },
        "width": {
          "type": "number"
        }
      },
      "required": [
        "fieldname"
      ],
      "additionalProperties": false
    }
  }
}