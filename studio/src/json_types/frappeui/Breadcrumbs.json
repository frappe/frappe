{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/BreadcrumbsProps",
  "definitions": {
    "BreadcrumbsProps": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "description": "Text shown for the breadcrumb item"
              },
              "route": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object"
                  }
                ],
                "description": "Route location used when the item is a link"
              },
              "onClick": {
                "$comment": "() => void",
                "description": "Click handler for non-router breadcrumb items"
              }
            },
            "required": [
              "label"
            ],
            "additionalProperties": {
              "description": "Allows passing additional custom fields"
            }
          },
          "description": "Ordered list of breadcrumb items"
        }
      },
      "required": [
        "items"
      ],
      "additionalProperties": false
    }
  }
}