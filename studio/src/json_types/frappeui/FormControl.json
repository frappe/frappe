{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/FormControlProps",
  "definitions": {
    "FormControlProps": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "description": "Label text displayed above the input"
        },
        "description": {
          "type": "string",
          "description": "Optional description or helper text shown below the input"
        },
        "type": {
          "type": "string",
          "enum": [
            "date",
            "datetime-local",
            "email",
            "file",
            "month",
            "number",
            "password",
            "search",
            "tel",
            "text",
            "time",
            "url",
            "week",
            "range",
            "textarea",
            "select",
            "checkbox",
            "autocomplete",
            "combobox"
          ],
          "description": "Type of input to render"
        },
        "size": {
          "type": "string",
          "enum": [
            "sm",
            "md"
          ],
          "description": "Size of the input"
        },
        "variant": {
          "type": "string",
          "enum": [
            "subtle",
            "outline"
          ],
          "description": "Visual variant of the input"
        },
        "required": {
          "type": "boolean",
          "description": "Whether the input is required"
        }
      },
      "additionalProperties": false
    }
  }
}