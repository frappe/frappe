{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/DialogProps",
  "definitions": {
    "DialogProps": {
      "type": "object",
      "properties": {
        "modelValue": {
          "type": "boolean",
          "description": "Controls whether the dialog is open (v-model)"
        },
        "options": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "size": {
              "type": "string",
              "enum": [
                "xs",
                "sm",
                "md",
                "lg",
                "xl",
                "2xl",
                "3xl",
                "4xl",
                "5xl",
                "6xl",
                "7xl"
              ]
            },
            "icon": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "appearance": {
                      "type": "string",
                      "enum": [
                        "warning",
                        "info",
                        "danger",
                        "success"
                      ]
                    }
                  },
                  "required": [
                    "name"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "string"
                }
              ]
            },
            "actions": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "onClick": {
                    "$comment": "(context: DialogActionContext) => void | Promise<void>",
                    "type": "object",
                    "properties": {
                      "namedArgs": {
                        "type": "object",
                        "properties": {
                          "context": {
                            "type": "object",
                            "properties": {
                              "close": {
                                "$comment": "() => void"
                              }
                            },
                            "required": [
                              "close"
                            ],
                            "additionalProperties": false
                          }
                        },
                        "required": [
                          "context"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "theme": {
                    "type": "string",
                    "enum": [
                      "gray",
                      "blue",
                      "green",
                      "red"
                    ],
                    "description": "Visual color theme of the button"
                  },
                  "size": {
                    "type": "string",
                    "enum": [
                      "sm",
                      "md",
                      "lg",
                      "xl",
                      "2xl"
                    ],
                    "description": "Controls the button size"
                  },
                  "variant": {
                    "type": "string",
                    "enum": [
                      "solid",
                      "subtle",
                      "outline",
                      "ghost"
                    ],
                    "description": "Visual style of the button"
                  },
                  "label": {
                    "type": "string",
                    "description": "Text label displayed inside the button"
                  },
                  "icon": {
                    "type": [
                      "string"
                    ],
                    "description": "Icon shown when no left or right icon is specified"
                  },
                  "iconLeft": {
                    "type": [
                      "string"
                    ],
                    "description": "Icon shown before the label"
                  },
                  "iconRight": {
                    "type": [
                      "string"
                    ],
                    "description": "Icon shown after the label"
                  },
                  "tooltip": {
                    "type": "string",
                    "description": "Tooltip text shown on hover"
                  },
                  "loading": {
                    "type": "boolean",
                    "description": "Shows a loading state and disables interaction"
                  },
                  "loadingText": {
                    "type": "string",
                    "description": "Text shown while the button is loading"
                  },
                  "disabled": {
                    "type": "boolean",
                    "description": "Disables the button"
                  },
                  "route": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "object"
                      }
                    ],
                    "description": "Router destination when used as a link"
                  },
                  "link": {
                    "type": "string",
                    "description": "External link URL"
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "button",
                      "submit",
                      "reset"
                    ],
                    "description": "Native button type"
                  }
                }
              }
            },
            "position": {
              "type": "string",
              "enum": [
                "top",
                "center"
              ]
            },
            "paddingTop": {
              "type": [
                "string",
                "number"
              ]
            }
          },
          "additionalProperties": false,
          "description": "Configuration options for title, message, size, icon, actions, etc."
        },
        "disableOutsideClickToClose": {
          "type": "boolean",
          "description": "Prevents closing the dialog when clicking outside"
        }
      },
      "required": [
        "modelValue"
      ],
      "additionalProperties": false
    }
  }
}