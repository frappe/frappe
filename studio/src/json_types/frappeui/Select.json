{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/SelectProps",
  "definitions": {
    "SelectProps": {
      "type": "object",
      "properties": {
        "size": {
          "type": "string",
          "enum": [
            "sm",
            "md",
            "lg"
          ],
          "description": "Size of the select input"
        },
        "variant": {
          "type": "string",
          "enum": [
            "subtle",
            "outline",
            "ghost"
          ],
          "description": "Visual style of the select input"
        },
        "placeholder": {
          "type": "string",
          "description": "Placeholder text displayed when no option is selected"
        },
        "disabled": {
          "type": "boolean",
          "description": "If true, disables the select input"
        },
        "id": {
          "type": "string",
          "description": "Optional HTML id for the select element"
        },
        "modelValue": {
          "type": [
            "string",
            "number"
          ],
          "description": "The currently selected value (controlled)"
        },
        "options": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string"
                  },
                  "value": {
                    "type": "string"
                  },
                  "disabled": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "label",
                  "value"
                ],
                "additionalProperties": false
              }
            ]
          },
          "description": "Options to display in the dropdown"
        }
      },
      "additionalProperties": false
    }
  }
}