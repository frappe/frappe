{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/CircularProgressBarProps",
  "definitions": {
    "CircularProgressBarProps": {
      "type": "object",
      "properties": {
        "step": {
          "type": "number",
          "description": "Current step or progress value"
        },
        "totalSteps": {
          "type": "number",
          "description": "Total steps for completion"
        },
        "showPercentage": {
          "type": "boolean",
          "description": "Show numeric percentage inside the circle"
        },
        "variant": {
          "type": "string",
          "enum": [
            "solid",
            "outline"
          ],
          "description": "Visual style of the progress bar"
        },
        "theme": {
          "anyOf": [
            {
              "type": "string",
              "const": "black"
            },
            {
              "type": "string",
              "const": "red"
            },
            {
              "type": "string",
              "const": "green"
            },
            {
              "type": "string",
              "const": "blue"
            },
            {
              "type": "string",
              "const": "orange"
            },
            {
              "type": "object",
              "properties": {
                "primary": {
                  "type": "string"
                },
                "secondary": {
                  "type": "string"
                }
              },
              "required": [
                "primary",
                "secondary"
              ],
              "additionalProperties": false
            }
          ],
          "description": "Theme used for the progress bar (predefined or custom colors)"
        },
        "size": {
          "type": "string",
          "enum": [
            "xs",
            "sm",
            "md",
            "lg",
            "xl"
          ],
          "description": "Size of the progress bar"
        },
        "themeComplete": {
          "type": "string",
          "description": "Color used when the progress completes"
        }
      },
      "required": [
        "step",
        "totalSteps"
      ],
      "additionalProperties": false,
      "description": "Props for the CircularProgressBar component"
    }
  }
}