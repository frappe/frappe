{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/TimePickerProps",
  "definitions": {
    "TimePickerProps": {
      "type": "object",
      "properties": {
        "value": {
          "type": "string",
          "description": "Selected time (uncontrolled)"
        },
        "modelValue": {
          "type": "string",
          "description": "Selected time (v-model)"
        },
        "interval": {
          "type": "number",
          "description": "Minute interval between options"
        },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "value": {
                "type": "string"
              },
              "label": {
                "type": "string"
              }
            },
            "required": [
              "value"
            ],
            "additionalProperties": false
          },
          "description": "Custom time options"
        },
        "placement": {
          "type": "string",
          "enum": [
            "bottom-start",
            "top-start",
            "top-end",
            "bottom-end",
            "right-start",
            "right-end",
            "left-start",
            "left-end"
          ],
          "description": "Popover placement"
        },
        "placeholder": {
          "type": "string",
          "description": "Placeholder text when no value is selected"
        },
        "variant": {
          "type": "string",
          "enum": [
            "outline",
            "subtle"
          ],
          "description": "Visual style variant"
        },
        "allowCustom": {
          "type": "boolean",
          "description": "Allow entering custom time values"
        },
        "autoClose": {
          "type": "boolean",
          "description": "Close picker automatically after selection"
        },
        "use12Hour": {
          "type": "boolean",
          "description": "Use 12-hour (AM/PM) format"
        },
        "disabled": {
          "type": "boolean",
          "description": "Disable the time picker"
        },
        "scrollMode": {
          "type": "string",
          "enum": [
            "center",
            "start",
            "nearest"
          ],
          "description": "Scroll behavior when opening the list"
        },
        "minTime": {
          "type": "string",
          "description": "Minimum selectable time"
        },
        "maxTime": {
          "type": "string",
          "description": "Maximum selectable time"
        }
      },
      "additionalProperties": false
    }
  }
}