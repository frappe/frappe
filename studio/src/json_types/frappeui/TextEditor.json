{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/TextEditorProps",
  "definitions": {
    "TextEditorProps": {
      "type": "object",
      "properties": {
        "content": {
          "type": [
            "string",
            "null"
          ],
          "description": "Initial editor content (HTML/string). `null` renders an empty editor"
        },
        "placeholder": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$comment": "() => string"
            }
          ],
          "description": "Placeholder text or dynamic placeholder resolver"
        },
        "editorClass": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "object"
            }
          ],
          "description": "Custom classes applied to the editor root"
        },
        "editable": {
          "type": "boolean",
          "description": "Toggles editability of the editor"
        },
        "autofocus": {
          "type": "boolean",
          "description": "Autofocus the editor on mount"
        },
        "bubbleMenu": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "array",
              "items": {}
            }
          ],
          "description": "Enables bubble menu or provides custom bubble menu items"
        },
        "bubbleMenuOptions": {
          "type": "object",
          "description": "Configuration options for the bubble menu"
        },
        "fixedMenu": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "array",
              "items": {}
            }
          ],
          "description": "Enables fixed menu or provides custom fixed menu items"
        },
        "floatingMenu": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "array",
              "items": {}
            }
          ],
          "description": "Enables floating menu or provides custom floating menu items"
        },
        "extensions": {
          "type": "array",
          "items": {},
          "description": "Custom TipTap extensions"
        },
        "starterkitOptions": {
          "description": "Options passed to TipTap StarterKit"
        },
        "mentions": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "mentions": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "title": {
                        "type": "string"
                      },
                      "name": {
                        "type": "string"
                      },
                      "id": {
                        "type": "string"
                      },
                      "label": {
                        "type": "string"
                      },
                      "value": {
                        "type": "string"
                      },
                      "email": {
                        "type": "string"
                      },
                      "full_name": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "id",
                      "label"
                    ]
                  }
                },
                "component": {
                  "type": "string"
                }
              },
              "required": [
                "mentions"
              ],
              "additionalProperties": false
            },
            {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "id": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string"
                  },
                  "value": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string"
                  },
                  "full_name": {
                    "type": "string"
                  }
                },
                "required": [
                  "id",
                  "label"
                ]
              }
            },
            {
              "type": "null"
            }
          ],
          "description": "Mention extension configuration"
        },
        "tags": {
          "anyOf": [
            {
              "type": "array",
              "items": {}
            },
            {
              "type": "null"
            }
          ],
          "description": "Tag / hashtag configuration"
        },
        "uploadFunction": {
          "$comment": "(file: File) => Promise<UploadedFile>",
          "type": "object",
          "properties": {
            "namedArgs": {
              "type": "object",
              "properties": {
                "file": {
                  "type": "object",
                  "properties": {
                    "size": {
                      "type": "number"
                    },
                    "type": {
                      "type": "string"
                    },
                    "lastModified": {
                      "type": "number"
                    },
                    "name": {
                      "type": "string"
                    },
                    "webkitRelativePath": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "lastModified",
                    "name",
                    "size",
                    "type",
                    "webkitRelativePath"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "file"
              ],
              "additionalProperties": false
            }
          },
          "description": "Async file upload handler (used for images, files, etc.)"
        },
        "uploadArgs": {
          "type": "object",
          "description": "Extra arguments passed to the upload function"
        }
      },
      "additionalProperties": false
    }
  }
}