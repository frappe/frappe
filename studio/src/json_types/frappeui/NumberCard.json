{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "NumberCardProps": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "value": {
          "type": [
            "number",
            "string",
            "null"
          ]
        },
        "color": {
          "type": "string"
        },
        "prefix": {
          "type": "string"
        },
        "suffix": {
          "type": "string"
        },
        "target": {
          "type": [
            "number",
            "string"
          ]
        },
        "delta": {
          "type": [
            "number",
            "null"
          ]
        },
        "deltaPrefix": {
          "type": "string"
        },
        "deltaSuffix": {
          "type": "string"
        },
        "deltaCaption": {
          "type": "string"
        },
        "negativeIsBetter": {
          "type": "boolean"
        },
        "format": {
          "type": "object"
        },
        "deltaFormat": {
          "type": "object"
        },
        "sparkline": {
          "type": "object",
          "properties": {
            "data": {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  },
                  {
                    "not": {}
                  }
                ]
              }
            },
            "type": {
              "type": "string",
              "enum": [
                "bar",
                "line",
                "area"
              ]
            },
            "color": {
              "type": "string"
            }
          },
          "required": [
            "data"
          ],
          "additionalProperties": false
        },
        "card": {
          "type": "boolean"
        },
        "dir": {
          "type": "string",
          "enum": [
            "ltr",
            "rtl"
          ]
        },
        "loading": {
          "type": "boolean"
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "title",
        "value"
      ]
    },
    "NumberCardSlots": {
      "type": "object",
      "properties": {
        "caption": {
          "type": "object"
        },
        "actions": {
          "type": "object"
        }
      }
    }
  }
}