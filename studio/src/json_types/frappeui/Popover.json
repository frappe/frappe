{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/PopoverProps",
  "definitions": {
    "PopoverProps": {
      "type": "object",
      "properties": {
        "show": {
          "type": "boolean",
          "description": "Controls visibility of the popover"
        },
        "trigger": {
          "type": "string",
          "enum": [
            "click",
            "hover"
          ],
          "description": "Event that triggers the popover"
        },
        "hoverDelay": {
          "type": "number",
          "description": "Delay in ms before showing popover on hover"
        },
        "leaveDelay": {
          "type": "number",
          "description": "Delay in ms before hiding popover on hover leave"
        },
        "placement": {
          "type": "string",
          "enum": [
            "top-start",
            "top-end",
            "bottom-start",
            "bottom-end",
            "right-start",
            "right-end",
            "left-start",
            "left-end",
            "top",
            "bottom",
            "right",
            "left"
          ],
          "description": "Placement of the popover relative to the target"
        },
        "popoverClass": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "object"
            },
            {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object"
                  }
                ]
              }
            }
          ]
        },
        "transition": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "default",
            null
          ],
          "description": "Transition style to use"
        },
        "hideOnBlur": {
          "type": "boolean",
          "description": "Whether to hide the popover when clicking outside"
        },
        "matchTargetWidth": {
          "type": "boolean",
          "description": "Whether the popover width should match the target element"
        },
        "offset": {
          "type": "number"
        }
      },
      "additionalProperties": false
    }
  }
}