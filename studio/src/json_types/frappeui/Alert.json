{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/AlertProps",
  "definitions": {
    "AlertProps": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "Main heading text of the alert"
        },
        "theme": {
          "type": "string",
          "enum": [
            "yellow",
            "blue",
            "red",
            "green"
          ],
          "description": "Color theme of the alert",
          "default": "blue"
        },
        "variant": {
          "type": "string",
          "enum": [
            "subtle",
            "outline"
          ],
          "description": "Visual style of the alert container",
          "default": "subtle"
        },
        "description": {
          "type": "string",
          "description": "Optional supporting text shown below the title"
        },
        "dismissable": {
          "type": "boolean",
          "description": "Whether the alert can be closed by the user",
          "default": false
        }
      },
      "required": [
        "title"
      ],
      "additionalProperties": false
    }
  }
}