{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/DatePickerProps",
  "definitions": {
    "DatePickerProps": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "messages": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  ]
                },
                "name": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                },
                "stack": {
                  "type": "string"
                }
              },
              "required": [
                "message",
                "name"
              ]
            }
          ]
        },
        "required": {
          "type": "boolean"
        },
        "id": {
          "type": "string"
        },
        "side": {
          "type": "string",
          "enum": [
            "top",
            "right",
            "bottom",
            "left"
          ]
        },
        "align": {
          "type": "string",
          "enum": [
            "start",
            "center",
            "end"
          ]
        },
        "offset": {
          "type": "number"
        },
        "format": {
          "type": "string"
        },
        "size": {
          "type": "string",
          "enum": [
            "xs",
            "sm",
            "md",
            "lg"
          ]
        },
        "variant": {
          "type": "string",
          "enum": [
            "subtle",
            "outline",
            "ghost"
          ]
        },
        "placeholder": {
          "type": "string"
        },
        "open": {
          "type": "boolean"
        },
        "openOnFocus": {
          "type": "boolean"
        },
        "openOnClick": {
          "type": "boolean"
        },
        "typeable": {
          "type": "boolean"
        },
        "disabled": {
          "type": "boolean"
        },
        "clearable": {
          "type": "boolean"
        },
        "keepOpen": {
          "type": "boolean"
        },
        "min": {
          "type": "string"
        },
        "max": {
          "type": "string"
        },
        "isDateUnavailable": {
          "type": "object"
        },
        "modelValue": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}