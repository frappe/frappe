{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/*",
  "definitions": {
    "*": {
      "type": "object",
      "properties": {
        "as": {
          "type": "string"
        },
        "tabs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string"
              },
              "icon": {
                "type": "string"
              },
              "route": {
                "type": "string"
              }
            },
            "required": [
              "label"
            ],
            "additionalProperties": false
          }
        },
        "vertical": {
          "type": "object",
          "additionalProperties": false
        }
      },
      "required": [
        "tabs"
      ],
      "additionalProperties": false
    }
  }
}