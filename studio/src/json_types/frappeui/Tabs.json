{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/*",
  "definitions": {
    "*": {
      "type": "object",
      "properties": {
        "as": {
          "type": "string",
          "description": "Element/component used to render the tab container"
        },
        "tabs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "description": "Text shown for the tab"
              },
              "icon": {
                "type": "string",
                "description": "Optional icon name displayed with the label"
              },
              "route": {
                "type": "string",
                "description": "Optional route to navigate to when the tab is clicked"
              }
            },
            "required": [
              "label"
            ],
            "additionalProperties": false
          },
          "description": "List of tabs to render"
        },
        "vertical": {
          "type": "boolean",
          "description": "Renders tabs vertically instead of horizontally"
        }
      },
      "required": [
        "tabs"
      ],
      "additionalProperties": false
    }
  }
}