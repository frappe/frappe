                "type": [
                  "string",
                  "number"
                ]
              },
              "label": {
                "type": "string"
              },
              "icon": {
                "type": [
                  "string"
                ]
              },
              "iconLeft": {
                "type": [
                  "string"
                ]
              },
              "disabled": {
                "type": "boolean"
              },
