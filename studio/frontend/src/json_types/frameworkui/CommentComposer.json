{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "CommentComposerProps": {
      "type": "object",
      "properties": {
        "placeholder": {
          "type": "string"
        },
        "submitLabel": {
          "type": "string"
        },
        "uploadFunction": {
          "type": "object"
        },
        "extensions": {
          "type": "array",
          "items": {}
        },
        "maxAttachments": {
          "type": "number"
        },
        "submitting": {
          "type": "boolean"
        },
        "mentions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string"
              },
              "value": {
                "type": "string"
              }
            },
            "required": [
              "label",
              "value"
            ],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "CommentComposerSlots": {
      "type": "object",
      "properties": {
        "actions": {
          "type": "object"
        },
        "footer": {
          "type": "object"
        }
      },
      "additionalProperties": false
    }
  }
}