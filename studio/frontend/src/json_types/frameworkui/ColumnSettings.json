{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ColumnSettingsProps": {
      "type": "object",
      "properties": {
        "doctype": {
          "type": "string"
        },
        "hideLabel": {
          "type": "boolean"
        },
        "canReset": {
          "type": "boolean"
        },
        "synthetic": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "align": {
                "type": "string",
                "enum": [
                  "left",
                  "right"
                ]
              },
              "width": {
                "type": "string"
              },
              "place": {
                "type": "string",
                "enum": [
                  "start",
                  "after-title",
                  "end"
                ]
              },
              "subsumes": {
                "type": "string"
              }
            },
            "required": [
              "key",
              "label"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "doctype"
      ],
      "additionalProperties": false
    }
  }
}