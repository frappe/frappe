{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "EmailItemProps": {
      "type": "object",
      "properties": {
        "email": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "email"
            },
            "key": {
              "type": "string"
            },
            "timestamp": {
              "type": "string"
            },
            "author": {
              "type": "object",
              "properties": {
                "email": {
                  "type": "string"
                },
                "fullname": {
                  "type": "string"
                },
                "image": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            "icon": {
              "type": [
                "string"
              ]
            },
            "data": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "subject": {
                  "type": "string"
                },
                "sender": {
                  "type": "string"
                },
                "to": {
                  "type": "string"
                },
                "cc": {
                  "type": "string"
                },
                "bcc": {
                  "type": "string"
                },
                "content": {
                  "type": "string"
                },
                "deliveryStatus": {
                  "type": "string"
                },
                "attachments": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "file_url": {
                        "type": "string"
                      },
                      "is_private": {
                        "type": "number",
                        "enum": [
                          0,
                          1
                        ]
                      },
                      "file_name": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "file_url"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "name",
                "sender",
                "content"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "type",
            "key",
            "data"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "email"
      ],
      "additionalProperties": false
    },
    "EmailItemSlots": {
      "type": "object",
      "properties": {
        "header": {
          "type": "object"
        },
        "actions": {
          "type": "object"
        },
        "footer": {
          "type": "object"
        }
      },
      "additionalProperties": false
    }
  }
}