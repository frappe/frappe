{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "FilterProps": {
      "type": "object",
      "properties": {
        "doctype": {
          "type": "string"
        },
        "fields": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string"
                  },
                  "fieldname": {
                    "type": "string"
                  },
                  "fieldtype": {
                    "type": "string"
                  },
                  "options": {
                    "type": "string"
                  }
                },
                "required": [
                  "label",
                  "fieldname",
                  "fieldtype"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "align": {
          "type": "string",
          "enum": [
            "start",
            "end"
          ]
        }
      },
      "required": [
        "doctype"
      ],
      "additionalProperties": false
    }
  }
}