{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ScatterChartProps": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "data": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "x": {
          "type": "string"
        },
        "y": {
          "type": "string"
        },
        "size": {
          "type": "string"
        },
        "splitBy": {
          "type": "string"
        },
        "hiddenSeries": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "label": {
          "type": "string"
        },
        "showDataLabels": {
          "type": "boolean"
        },
        "xAxis": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string"
            },
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            },
            "format": {
              "type": "object"
            },
            "echartOptions": {
              "type": "object"
            }
          },
          "additionalProperties": false
        },
        "yAxis": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string"
            },
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            },
            "format": {
              "type": "object"
            },
            "echartOptions": {
              "type": "object"
            }
          },
          "additionalProperties": false
        },
        "palette": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "sequential",
                "categorical",
                "diverging"
              ]
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "referenceLines": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "value": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "string"
                  },
                  {
                    "type": "string",
                    "format": "date-time"
                  }
                ]
              },
              "axis": {
                "type": "string",
                "enum": [
                  "y",
                  "y2",
                  "x"
                ]
              },
              "label": {
                "type": "string"
              },
              "labelPlacement": {
                "type": "string",
                "enum": [
                  "start-top",
                  "start-bottom",
                  "end-top",
                  "end-bottom"
                ]
              },
              "color": {
                "type": "string"
              },
              "dashed": {
                "type": "boolean"
              }
            },
            "required": [
              "value"
            ],
            "additionalProperties": false
          }
        },
        "format": {
          "type": "object"
        },
        "echartOptions": {
          "type": "object"
        },
        "title": {
          "type": "string"
        },
        "subtitle": {
          "type": "string"
        },
        "dir": {
          "type": "string",
          "enum": [
            "ltr",
            "rtl"
          ]
        },
        "loading": {
          "type": "boolean"
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "data",
        "x",
        "y"
      ]
    },
    "ScatterChartSlots": {
      "type": "object",
      "properties": {
        "tooltip": {
          "type": "object"
        },
        "title-suffix": {
          "type": "object"
        },
        "actions": {
          "type": "object"
        }
      }
    }
  }
}