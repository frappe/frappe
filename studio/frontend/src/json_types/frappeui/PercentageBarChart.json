{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "PercentageBarChartProps": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "data": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "category": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "maxSlices": {
          "type": "number"
        },
        "order": {
          "type": "string",
          "enum": [
            "size",
            "rows"
          ]
        },
        "hiddenSlices": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "format": {
          "type": "object"
        },
        "palette": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "sequential",
                "categorical",
                "diverging"
              ]
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "colors": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "title": {
          "type": "string"
        },
        "subtitle": {
          "type": "string"
        },
        "dir": {
          "type": "string",
          "enum": [
            "ltr",
            "rtl"
          ]
        },
        "loading": {
          "type": "boolean"
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "category",
        "data",
        "value"
      ]
    },
    "PercentageBarChartSlots": {
      "type": "object",
      "properties": {
        "tooltip": {
          "type": "object"
        },
        "title-suffix": {
          "type": "object"
        },
        "actions": {
          "type": "object"
        }
      }
    }
  }
}