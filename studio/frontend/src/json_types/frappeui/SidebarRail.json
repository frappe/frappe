{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/*",
  "definitions": {
    "*": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "icon": {
          "type": [
            "string"
          ]
        },
        "route": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "object"
            }
          ]
        },
        "href": {
          "type": "string"
        },
        "active": {
          "type": "boolean"
        },
        "badge": {
          "type": "number"
        },
        "badgeStyle": {
          "type": "string",
          "enum": [
            "count",
            "dot"
          ]
        },
        "variant": {
          "type": "string",
          "enum": [
            "subtle",
            "ghost"
          ]
        }
      },
      "required": [
        "label"
      ],
      "additionalProperties": false
    }
  }
}