{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/SelectProps",
  "definitions": {
    "SelectProps": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "messages": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  ]
                },
                "name": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                },
                "stack": {
                  "type": "string"
                }
              },
              "required": [
                "message",
                "name"
              ]
            }
          ]
        },
        "required": {
          "type": "boolean"
        },
        "id": {
          "type": "string"
        },
        "size": {
          "type": "string",
          "enum": [
            "xs",
            "sm",
            "md",
            "lg"
          ]
        },
        "variant": {
          "type": "string",
          "enum": [
            "subtle",
            "outline",
            "ghost"
          ]
        },
        "placeholder": {
          "type": "string"
        },
        "disabled": {
          "type": "boolean"
        },
        "modelValue": {
          "anyOf": [
            {
              "type": [
                "string",
                "number"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "open": {
          "type": "boolean"
        },
        "options": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string"
                  },
                  "value": {
                    "type": [
                      "string",
                      "number"
                    ]
                  },
                  "disabled": {
                    "type": "boolean"
                  },
                  "icon": {
                    "type": [
                      "string"
                    ]
                  },
                  "description": {
                    "type": "string"
                  },
                  "slot": {
                    "type": "string"
                  }
                },
                "required": [
                  "label",
                  "value"
                ]
              }
            ]
          }
        },
        "emptyText": {
          "type": "string"
        },
        "side": {
          "type": "string",
          "enum": [
            "top",
            "right",
            "bottom",
            "left"
          ]
        },
        "align": {
          "type": "string",
          "enum": [
            "start",
            "center",
            "end"
          ]
        },
        "offset": {
          "type": "number"
        },
        "portalTo": {
          "type": [
            "string"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}