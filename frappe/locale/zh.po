"{% endif %}\n"
"\n"
"&lt;h4&gt;详情&lt;/h4&gt;\n"
"\n"
"&lt;ul&gt;\n"
"&lt;li&gt;客户: {{ doc.customer }}\n"
"&lt;li&gt;金额: {{ doc.grand_total }}\n"
"&lt;/ul&gt;\n"
"</pre>"

