"{% endif %}\n\n"
"&lt;h4&gt;Details&lt;/h4&gt;\n\n"
"&lt;ul&gt;\n"
"&lt;li&gt;Customer: {{ doc.customer }}\n"
"&lt;li&gt;Amount: {{ doc.grand_total }}\n"
"&lt;/ul&gt;\n"
"</pre>"
msgstr "<h5>Mesaj Örneği</h5>\n\n"
"<pre>&lt;h3&gt;Sipariş Gecikmiş&lt;/h3&gt;\n\n"
"&lt;p&gt;İşlem {{ doc.name }} Son Tarihi aştı. Lütfen gerekli işlemi yapın.&lt;/p&gt;\n\n"
"&lt;!-- son yorumu göster --&gt;\n"
"{% if comments %}\n"
"Son yorum: {{ comments[-1].comment }} tarafından {{ comments[-1].by }}\n"
"{% endif %}\n\n"
"&lt;h4&gt;Ayrıntılar&lt;/h4&gt;\n\n"
"&lt;ul&gt;\n"
"&lt;li&gt;Müşteri: {{ doc.customer }}\n"
"&lt;li&gt;Tutar: {{ doc.grand_total }}\n"
"&lt;/ul&gt;\n"
"</pre>"

