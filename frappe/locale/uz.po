#. Description of the 'Template' (Code) field in DocType 'Address Template'
#: frappe/contacts/doctype/address_template/address_template.json:35
#, python-brace-format, python-format
msgid "<h4>Default Template</h4>\n"
"<p>Uses <a href=\"http://jinja.pocoo.org/docs/templates/\">Jinja Templating</a> and all the fields of Address (including Custom Fields if any) will be available</p>\n"
"<pre><code>{{ address_line1 }}&lt;br&gt;\n"
"{% if address_line2 %}{{ address_line2 }}&lt;br&gt;{% endif -%}\n"
"{{ city }}&lt;br&gt;\n"
"{% if state %}{{ state }}&lt;br&gt;{% endif -%}\n"
"{% if pincode %} PIN:  {{ pincode }}&lt;br&gt;{% endif -%}\n"
"{{ country }}&lt;br&gt;\n"
"{% if phone %}Phone: {{ phone }}&lt;br&gt;{% endif -%}\n"
"{% if fax %}Fax: {{ fax }}&lt;br&gt;{% endif -%}\n"
"{% if email_id %}Email: {{ email_id }}&lt;br&gt;{% endif -%}\n"
"</code></pre>"
msgstr "<h4>Standart shablon</h4>\n"
"<p>Foydalanish <a href=\"http://jinja.pocoo.org/docs/templates/\">Jinja shablonlash</a> va manzilning barcha maydonlari (agar mavjud bo'lsa, maxsus maydonlar ham shu jumladan) mavjud bo'ladi</p>\n"
"<pre><code>{{ address_line1 }}&lt;br&gt;\n"
"{% if address_line2 %}{{ address_line2 }}&lt;br&gt;{% endif -%}\n"
"{{ city }}&lt;br&gt;\n"
"{% if state %}{{ state }}&lt;br&gt;{% endif -%}\n"
"{% if pincode %} PIN-kod:  {{ pincode }}&lt;br&gt;{% endif -%}\n"
"{{ country }}&lt;br&gt;\n"
"{% if phone %}Telefon: {{ phone }}&lt;br&gt;{% endif -%}\n"
"{% if fax %}Faks: {{ fax }}&lt;br&gt;{% endif -%}\n"
"{% if email_id %}Elektron pochta: {{ email_id }}&lt;br&gt;{% endif -%}\n"
"</code></pre>"

#. Content of the 'Email Reply Help' (HTML) field in DocType 'Email Template'
#: frappe/email/doctype/email_template/email_template.json:42
msgid "<h4>Email Reply Example</h4>\n\n"
"<pre>Order Overdue\n\n"
"Transaction {{ name }} has exceeded Due Date. Please take necessary action.\n\n"
"Details\n\n"
"- Customer: {{ customer }}\n"
"- Amount: {{ grand_total }}\n"
"</pre>\n\n"
"<h4>How to get fieldnames</h4>\n\n"
"<p>The fieldnames you can use in your email template are the fields in the document from which you are sending the email. You can find out the fields of any documents via Setup &gt; Customize Form View and selecting the document type (e.g. Sales Invoice)</p>\n\n"
"<h4>Templating</h4>\n\n"
"<p>Templates are compiled using the Jinja Templating Language. To learn more about Jinja, <a class=\"strong\" href=\"http://jinja.pocoo.org/docs/dev/templates/\">read this documentation.</a></p>\n"
msgstr "<h4>Elektron pochta orqali javob berish misoli</h4>\n\n"
"<pre>Buyurtma muddati o'tgan\n\n"
"Tranzaksiya {{ name }} muddati o'tib ketdi. Iltimos, zarur choralarni ko'ring.\n\n"
"Tafsilotlar\n\n"
"- Mijoz: {{ customer }}\n"
"- Miqdor: {{ grand_total }}\n"
"</pre>\n\n"
"<h4>Maydon nomlarini qanday olish mumkin</h4>\n\n"
"<p>Elektron pochta shabloningizda foydalanishingiz mumkin bo'lgan maydon nomlari - bu siz foydalanadigan hujjatdagi maydonlardir. elektron pochta xabarini yubormoqdasiz. Siz istalgan hujjatlar maydonlarini &gt; Forma ko'rinishini sozlash va hujjat turini (masalan, savdo fakturasini) tanlash orqali bilib olishingiz mumkin</p>\n\n"
"<h4>Shablonlash</h4>\n\n"
"<p>Shablonlar Jinja shablonlash tili yordamida kompilyatsiya qilinadi. Jinja haqida ko'proq bilish uchun <a class=\"strong\" href=\"http://jinja.pocoo.org/docs/dev/templates/\">ushbu hujjatlarni o'qing.</a></p>\n"

#. Content of the 'html_5' (HTML) field in DocType 'Data Import'
#: frappe/core/doctype/data_import/data_import.json:147
msgid "<h5 class=\"text-muted uppercase\">Or</h5>"
msgstr "<h5 class=\"text-muted uppercase\">Yoki</h5>"

#. Content of the 'Message Examples' (HTML) field in DocType 'Notification'
#: frappe/email/doctype/notification/notification.json:247
#, python-brace-format, python-format
msgid "<h5>Message Example</h5>\n\n"
"<pre>&lt;h3&gt;Order Overdue&lt;/h3&gt;\n\n"
"&lt;p&gt;Transaction {{ doc.name }} has exceeded Due Date. Please take necessary action.&lt;/p&gt;\n\n"
"&lt;!-- show last comment --&gt;\n"
"{% if comments %}\n"
"Last comment: {{ comments[-1].comment }} by {{ comments[-1].by }}\n"
"{% endif %}\n\n"
"&lt;h4&gt;Details&lt;/h4&gt;\n\n"
"&lt;ul&gt;\n"
"&lt;li&gt;Customer: {{ doc.customer }}\n"
"&lt;li&gt;Amount: {{ doc.grand_total }}\n"
"&lt;/ul&gt;\n"
"</pre>"
msgstr "<h5>Xabar namunasi</h5>\n\n"
"<pre>&lt;h3&gt;Buyurtmaning muddati o'tgan&lt;/h3&gt;\n\n"
"&lt;p&gt;Tranzaksiya {{ doc.name }} muddati o'tib ketdi. Iltimos, zarur choralarni ko'ring.&lt;/p&gt;\n\n"
"&lt;!-- oxirgi izohni ko'rsatish --&gt;\n"
"{% if comments %}\n"
"Oxirgi izoh: {{ comments[-1].comment }} muallifi {{ comments[-1].by }}\n"
"{% endif %}\n\n"
"&lt;h4&gt;Tafsilotlar&lt;/h4&gt;\n\n"
"&lt;ul&gt;\n"
"&lt;li&gt;Mijoz: {{ doc.customer }}\n"
"&lt;li&gt;Miqdor: {{ doc.grand_total }}\n"
"&lt;/ul&gt;\n"
"</pre>"

