#: frappe/email/doctype/notification/notification.json:247
#, python-brace-format, python-format
msgid "<h5>Message Example</h5>\n\n"
"<pre>&lt;h3&gt;Order Overdue&lt;/h3&gt;\n\n"
"&lt;p&gt;Transaction {{ doc.name }} has exceeded Due Date. Please take necessary action.&lt;/p&gt;\n\n"
"&lt;!-- show last comment --&gt;\n"
"{% if comments %}\n"
"Last comment: {{ comments[-1].comment }} by {{ comments[-1].by }}\n"
"{% endif %}\n\n"
"&lt;h4&gt;Details&lt;/h4&gt;\n\n"
"&lt;ul&gt;\n"
"&lt;li&gt;Customer: {{ doc.customer }}\n"
"&lt;li&gt;Amount: {{ doc.grand_total }}\n"
"&lt;/ul&gt;\n"
"</pre>"
msgstr "<h5>Üzenet példa</h5>\n\n"
"<pre>&lt;h3&gt;Rendelés késedelmes&lt;/h3&gt;\n\n"
"&lt;p&gt;Tranzakció {{ doc.name }} túllépte az esedékességi dátumot. Kérjük, tegye meg a szükséges lépéseket.&lt;/p&gt;\n\n"
"&lt;!-- utolsó megjegyzés megjelenítése --&gt;\n"
"{% if comments %}\n"
"Utolsó megjegyzés: {{ comments[-1].comment }} tőle {{ comments[-1].by }}\n"
"{% endif %}\n\n"
"&lt;h4&gt;Részletek&lt;/h4&gt;\n\n"
"&lt;ul&gt;\n"
"&lt;li&gt;Ügyfél: {{ doc.customer }}\n"
"&lt;li&gt;Összeg: {{ doc.grand_total }}\n"
"&lt;/ul&gt;\n"
"</pre>"

