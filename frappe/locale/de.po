"Last comment: {{ comments[-1].comment }} by {{ comments[-1].by }}\n"
"{% endif %}\n\n"
"&lt;h4&gt;Details&lt;/h4&gt;\n\n"
"&lt;ul&gt;\n"
"&lt;li&gt;Customer: {{ doc.customer }}\n"
"&lt;li&gt;Amount: {{ doc.grand_total }}\n"
"&lt;/ul&gt;\n"
"</pre>"
msgstr "<h5>Nachrichtenbeispiel</h5>\n\n"
"<pre>&lt;h3&gt;Bestellung überfällig&lt;/h3&gt;\n\n"
"&lt;p&gt;Transaktion {{ doc.name }} hat das Fälligkeitsdatum überschritten. Bitte ergreifen Sie die notwendigen Maßnahmen.&lt;/p&gt;\n\n"
"&lt;!-- letzten Kommentar anzeigen --&gt;\n"
"{% if comments %}\n"
"Letzter Kommentar: {{ comments[-1].comment }} von {{ comments[-1].by }}\n"
"{% endif %}\n\n"
"&lt;h4&gt;Details&lt;/h4&gt;\n\n"
"&lt;ul&gt;\n"
"&lt;li&gt;Kunde: {{ doc.customer }}\n"
"&lt;li&gt;Betrag: {{ doc.grand_total }}\n"
"&lt;/ul&gt;\n"
"</pre>"

