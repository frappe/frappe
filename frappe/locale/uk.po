msgid "Naming"
msgstr "Найменування"

#. Description of the 'Auto Name' (Data) field in DocType 'DocType'
#: frappe/core/doctype/doctype/doctype.json:221
#, python-brace-format
msgid "Naming Options:\n"
"<ol><li><b>field:[fieldname]</b> - By Field</li><li><b>autoincrement</b> - Uses Databases' Auto Increment feature</li><li><b>naming_series:</b> - By Naming Series (field called naming_series must be present)</li><li><b>Prompt</b> - Prompt user for a name</li><li><b>[series]</b> - Series by prefix (separated by a dot); for example PRE.#####</li>\n"
"<li><b>format:EXAMPLE-{MM}morewords{fieldname1}-{fieldname2}-{#####}</b> - Replace all braced words (fieldnames, date words (DD, MM, YY), series) with their value. Outside braces, any characters can be used.</li></ol>"
msgstr "Параметри найменування:\n"
"<ol><li><b>field:[fieldname]</b> - За полем</li><li><b>autoincrement</b> - Використовує функцію автоматичного інкрементування бази даних</li><li><b>naming_series:</b> - За серією нумерації (має бути присутнє поле naming_series)</li><li><b>Prompt</b> - Запитує користувача ввести назву</li><li><b>[series]</b> - Серія за префіксом (розділена крапкою); наприклад PRE.#####</li>\n"
"<li><b>format:EXAMPLE-{MM}morewords{fieldname1}-{fieldname2}-{#####}</b> - Замінює всі слова у фігурних дужках (назви полів, слова дат (DD, MM, YY), серія) їх значеннями. Поза фігурними дужками можна використовувати будь-які символи.</li></ol>"

#. Description of the 'Auto Name' (Data) field in DocType 'Customize Form'
#: frappe/custom/doctype/customize_form/customize_form.json:308
#, python-brace-format
msgid "Naming Options:\n"
"<ol><li><b>field:[fieldname]</b> - By Field</li><li><b>naming_series:</b> - By Naming Series (field called naming_series must be present)</li><li><b>Prompt</b> - Prompt user for a name</li><li><b>[series]</b> - Series by prefix (separated by a dot); for example PRE.#####</li>\n"
"<li><b>format:EXAMPLE-{MM}morewords{fieldname1}-{fieldname2}-{#####}</b> - Replace all braced words (fieldnames, date words (DD, MM, YY), series) with their value. Outside braces, any characters can be used.</li></ol>"
msgstr "Варіанти іменування:\n"
"<ol><li><b>field:[fieldname]</b> — за полем</li><li><b>naming_series:</b> — за серією нумерації (потрібне поле naming_series)</li><li><b>Prompt</b> — запитати назву в користувача</li><li><b>[series]</b> — серія за префіксом (через крапку), наприклад PRE.#####</li>\n"
"<li><b>format:EXAMPLE-{MM}morewords{fieldname1}-{fieldname2}-{#####}</b> — усі слова у фігурних дужках (імена полів, частини дати DD, MM, YY, серія) замінюються значеннями. Поза дужками можна писати будь-які символи.</li></ol>"

