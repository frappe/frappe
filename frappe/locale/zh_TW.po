"\treqd: 1\n"
"},\n"
"{\n"
"\tfieldname: \"account\",\n"
"\tlabel: __(\"Account\"),\n"
"\tfieldtype: \"Link\",\n"
"\toptions: \"Account\",\n"
"\treqd: 1\n"
"}]\n"
"</code></pre>"
msgstr "在此設定篩選條件。例如：\n"
"<pre class=\"small text-muted\"><code>\n"
"[{\n"
"\tfieldname: \"company\",\n"
"\tlabel: __(\"Company\"),\n"
"\tfieldtype: \"Link\",\n"
"\toptions: \"Company\",\n"
"\tdefault: frappe.defaults.get_user_default(\"Company\"),\n"
"\treqd: 1\n"
"},\n"
"{\n"
"\tfieldname: \"account\",\n"
"\tlabel: __(\"Account\"),\n"
"\tfieldtype: \"Link\",\n"
"\toptions: \"Account\",\n"
"\treqd: 1\n"
"}]\n"
"</code></pre>"

