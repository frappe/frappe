"│  └─────────────── hour (0 - 23)\n"
"└──────────────────── minute (0 - 59)\n\n"
"---\n\n"
"* - Any value\n"
"/ - Step values\n"
"</pre>\n"
msgstr "<pre>*  *  *  *  *\n"
"┬  ┬  ┬  ┬  ┬\n"
"│  │  │  │  │\n"
"│  │  │  │  └ 星期 (0 - 6)（0 為星期日）\n"
"│  │  │  └───── 月 (1 - 12)\n"
"│  │  └────────── 每月日期 (1 - 31)\n"
