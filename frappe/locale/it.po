"{% endif %}\n\n"
"&lt;h4&gt;Details&lt;/h4&gt;\n\n"
"&lt;ul&gt;\n"
"&lt;li&gt;Customer: {{ doc.customer }}\n"
"&lt;li&gt;Amount: {{ doc.grand_total }}\n"
"&lt;/ul&gt;\n"
"</pre>"
msgstr "<h5>Esempio di messaggio</h5>\n\n"
"<pre>&lt;h3&gt;Ordine in ritardo&lt;/h3&gt;\n\n"
"&lt;p&gt;La transazione {{ doc.name }} ha superato la data di scadenza. Si prega di intraprendere le azioni necessarie.&lt;/p&gt;\n\n"
"&lt;!-- mostra l'ultimo commento --&gt;\n"
"{% if comments %}\n"
"Ultimo commento: {{ comments[-1].comment }} di {{ comments[-1].by }}\n"
"{% endif %}\n\n"
"&lt;h4&gt;Dettagli&lt;/h4&gt;\n\n"
"&lt;ul&gt;\n"
"&lt;li&gt;Cliente: {{ doc.customer }}\n"
"&lt;li&gt;Importo: {{ doc.grand_total }}\n"
"&lt;/ul&gt;\n"
"</pre>"

