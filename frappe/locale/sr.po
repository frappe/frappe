"{% endif %}\n\n"
"&lt;h4&gt;Details&lt;/h4&gt;\n\n"
"&lt;ul&gt;\n"
"&lt;li&gt;Customer: {{ doc.customer }}\n"
"&lt;li&gt;Amount: {{ doc.grand_total }}\n"
"&lt;/ul&gt;\n"
"</pre>"
msgstr "<h5>Пример поруке</h5>\n\n"
"<pre>&lt;h3&gt;Рок за плаћање наруџбине је истекао&lt;/h3&gt;\n\n"
"&lt;п&gt;Трансакција {{ doc.name }} је премашила датум доспећа. Молимо Вас да предузмете одговарајуће радње.&lt;/p&gt;\n\n"
"&lt;!-- прикажи последњи коментар--&gt;\n"
"{% if comments %}\n"
"Последњи коментар: {{ comments[-1].comment }} од {{ comments[-1].by }}\n"
"{% endif %}\n\n"
"&lt;х4&gt;Детаљи&lt;/х4&gt;\n\n"
"&lt;ul&gt;\n"
"&lt;li&gt;Купац: {{ doc.customer }}\n"
"&lt;li&gt;Износ: {{ doc.grand_total }}\n"
"&lt;/ul&gt;\n"
"</pre>"

